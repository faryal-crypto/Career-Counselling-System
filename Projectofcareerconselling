char getValidAnswer()
{
	char answer;

	do
	{
		cout << "Enter your answer (A, B, C or D): ";
		cin >> answer;

		answer = toupper(answer);

		if (answer != 'A' && answer != 'B' &&
			answer != 'C' && answer != 'D')
		{
			cout << "Invalid input. Please enter A, B, C or D." << endl;
		}

	} while (answer != 'A' && answer != 'B' &&
		answer != 'C' && answer != 'D');

	return answer;
}
