void saveData(string recommendedField, float highest) {
	ofstream  fout("StudentrecordData.txt", ios::app);
	if (!fout) {
		cout << "There is no file found!";
		return;
	}
	fout << "-------------------------------------------" << endl;
	fout << "Career Counselling Student Data" << endl;
	fout << "-------------------------------------------" << endl << endl;
	fout << "Name: " << name << endl;
	fout << "Intermediate Marks: " << endl;
	fout << "Total Marks: " << totalMarks << endl;
	fout << "Obtained Marks: " << obtainedMarks << endl << endl;
	fout << "Medical Score: " << medicalScore << endl;
	fout << "Technology Score: " << technologyScore << endl;
	fout << "Business Score : " << businessScore << endl;
	fout << "Education Score: " << educationScore << endl;
	fout << endl << endl;
	fout << "Highest Score: " << highest << endl;
	fout << "Recommended Field: ";
	fout << recommendedField << endl;
	fout << "--------------------------------------------------" << endl;
	fout.close();
	cout << "File is saved succesfully." << endl;
}
